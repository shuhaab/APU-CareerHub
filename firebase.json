{
  "apphosting": [
    {
      "backendId": "apu-careerhub",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        ".env",
        ".env.*",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 19099,
      "host": "127.0.0.1"
    },
    "firestore": {
      "port": 18080,
      "websocketPort": 19150,
      "host": "127.0.0.1"
    },
    "storage": {
      "port": 19199,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": false,
      "port": 4000,
      "host": "127.0.0.1"
    }
  }
}
