rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function employerOwnsJob(jobId) {
      return hasRole('employer')
        && get(/databases/$(database)/documents/jobs/$(jobId)).data.employerId == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.accountActive == true;
      allow read: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.accountActive == resource.data.accountActive
        && request.resource.data.approved == resource.data.approved
        && request.resource.data.get('mustChangePassword', false) == resource.data.get('mustChangePassword', false)
        && request.resource.data.get('canManageAdmins', false) == resource.data.get('canManageAdmins', false))
        || (isAdmin()
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('mustChangePassword', false) == resource.data.get('mustChangePassword', false)
          && request.resource.data.get('canManageAdmins', false) == resource.data.get('canManageAdmins', false));
      allow delete: if isAdmin();

      match /documents/{documentId} {
        allow read: if isOwner(userId) || isAdmin();
        // Document metadata mutations are server-mediated so application-retention
        // and Storage cleanup checks cannot be bypassed by a direct client write.
        allow create, update, delete: if false;
      }
    }

    match /jobs/{jobId} {
      allow read: if resource.data.status == 'published'
        || isAdmin()
        || (hasRole('employer') && resource.data.employerId == request.auth.uid);
      allow create: if hasRole('employer')
        && request.resource.data.employerId == request.auth.uid
        && request.resource.data.status == 'draft';
      allow update: if isAdmin()
        || (hasRole('employer')
          && resource.data.employerId == request.auth.uid
          && request.resource.data.employerId == resource.data.employerId
          && request.resource.data.status in ['draft', 'pending_approval', 'rejected', 'closed']);
      allow delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow create: if hasRole('student')
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.currentStatus == 'submitted';
      allow read: if isAdmin()
        || (hasRole('student') && resource.data.studentId == request.auth.uid)
        || (hasRole('employer') && resource.data.employerId == request.auth.uid);
      allow update: if isAdmin()
        || (hasRole('employer') && resource.data.employerId == request.auth.uid)
        || (hasRole('student')
          && resource.data.studentId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentStatus', 'withdrawnAt', 'updatedAt'])
          && request.resource.data.currentStatus == 'withdrawn');
      allow delete: if false;

      match /statusHistory/{historyId} {
        allow read: if isAdmin()
          || (hasRole('student') && get(/databases/$(database)/documents/applications/$(applicationId)).data.studentId == request.auth.uid)
          || (hasRole('employer') && get(/databases/$(database)/documents/applications/$(applicationId)).data.employerId == request.auth.uid);
        allow create: if isAdmin() || employerOwnsJob(get(/databases/$(database)/documents/applications/$(applicationId)).data.jobId);
        allow update, delete: if false;
      }
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
