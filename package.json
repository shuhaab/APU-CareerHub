    "lucide-react": "^1.31.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
