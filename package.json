    "@types/yauzl": "3.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright": "1.65.0",
    "shadcn": "4.16.2",
    "tailwindcss": "^4",
    "typescript": "^5"
